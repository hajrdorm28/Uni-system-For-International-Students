{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run printing module",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/InternationalStudents.Printing/bin/Debug/net10.0/InternationalStudents.Printing.dll",
      "cwd": "${workspaceFolder}/src/InternationalStudents.Printing",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5080" },
      "serverReadyAction": { "action": "openExternally", "pattern": "Now listening on: (https?://\\S+)" }
    }
  ]
}
