@@ -0,0 +1,9 @@
+/* Staff "Print papers" page (js/printing.js). Uses the portal's variables and components. */
+.pr-hint { color: var(--muted); font-size: .88rem; margin: .4rem 0; }
+.pr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
+.pr-grow { flex: 1; min-width: 12rem; margin-top: 0; }
+/* the portal styles every <input> as a full-width block; radios must stay small */
+input.pr-radio { display: inline-block; width: auto; margin: 0; padding: 0; }
+tr.pr-sel td { background: var(--brand-l); }
+.pr-frame { width: 100%; height: 75vh; min-height: 480px; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
+@media (max-width: 720px) { .pr-grid { grid-template-columns: 1fr; } }
