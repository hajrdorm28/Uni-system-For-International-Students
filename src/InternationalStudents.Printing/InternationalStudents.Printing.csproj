<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InternationalStudents.Printing</RootNamespace>
    <AssemblyName>InternationalStudents.Printing</AssemblyName>
    <UserSecretsId>international-students-printing</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only third-party dependency: ADO.NET provider for MySQL/MariaDB. -->
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>

</Project>
