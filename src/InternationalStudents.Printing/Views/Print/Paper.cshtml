@model PaperPage
@* Shell around print_template.body_html. BodyHtml is staff-authored HTML with all values already encoded. *@
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
  <title>@Model.Title (@Model.ReferenceNo)</title>
  <style>
    :root { --ink: #1b1f23; --muted: #566270; --rule: #c4ccd3; --accent: #1f3a5f; }
    * { box-sizing: border-box; }
    html { background: #e6e9ec; }
    body { margin: 0; color: var(--ink); font: 10.5pt/1.5 "Segoe UI", "Noto Sans", "Helvetica Neue", Arial, Tahoma, sans-serif; }
    .sheet { width: 100%; max-width: 210mm; min-height: 297mm; margin: 6mm auto; padding: 14mm 16mm; background: #fff; }

    h1 { margin: 0 0 2mm; padding-bottom: 3mm; border-bottom: 0.5mm solid var(--accent); font-size: 15pt; color: var(--accent); }
    h2 { margin: 6mm 0 4mm; font-size: 18pt; }
    p { margin: 3mm 0; }
    table { width: 100%; margin: 4mm 0; border-collapse: collapse; }
    th, td { padding: 1.8mm 2mm; border: 0.25mm solid var(--rule); text-align: left; vertical-align: top; }
    th { width: 30%; background: #f3f5f7; font-weight: 600; }
    td { unicode-bidi: plaintext; }
    .ref { margin-top: 12mm; color: var(--muted); font-size: 8.5pt; }

    @@page { size: A4; margin: 14mm 16mm; }
    @@media print {
      html { background: #fff; }
      .sheet { margin: 0; padding: 0; max-width: none; min-height: 0; }
    }
  </style>
</head>
<body>
  <main class="sheet">
    @Html.Raw(Model.BodyHtml)
    <p class="ref">Printed document no. @Model.ReferenceNo</p>
  </main>
</body>
</html>
